# ───────── Core ─────────
TYPHOID_ENV=development
TYPHOID_SECRET_KEY=change-me-32-bytes-minimum
TYPHOID_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://typhoid:typhoid@postgres:5432/typhoid

# ───────── Auth / multi-tenancy ─────────
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
OIDC_ISSUER=
OIDC_CLIENT_ID=

# ───────── LLM (any OpenAI-compatible or Anthropic endpoint) ─────────
LLM_PROVIDER=anthropic            # anthropic | openai | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_REASONING=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://ollama:11434
LLM_MONTHLY_BUDGET_USD=500        # hard cap enforced by the cost governor
LLM_MAX_TOKENS=4096
VLM_MODEL=claude-sonnet-5

# ───────── Event bus ─────────
BUS_BACKEND=redis                 # redis | kafka
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_RUNS=typhoid.runs
KAFKA_TOPIC_EVENTS=typhoid.events

# ───────── Workflow engine ─────────
WORKFLOW_ENGINE=langgraph         # langgraph | temporal
LANGGRAPH_CHECKPOINT_DSN=postgresql://typhoid:typhoid@postgres:5432/typhoid
TEMPORAL_HOST=temporal:7233

# ───────── Knowledge (RAG + graph) ─────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=typhoid_bugs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=typhoid-neo4j

# ───────── Sandbox / chaos workers ─────────
WORKER_RUNTIME=docker             # docker | firecracker | k8s
WORKER_IMAGE=typhoid/runner:latest
WORKER_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=1g
WORKER_TTL_SECONDS=900
CHAOS_MAX_BLAST_RADIUS=0.3        # max fraction of traffic/services any experiment may hit
CHAOS_ALLOW_PRODUCTION=false

# ───────── Secrets (Zero-trust) ─────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-only-token
VAULT_ROLE=typhoid-worker

# ───────── Git providers (self-patch PRs) ─────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
GITHUB_WEBHOOK_SECRET=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_TOKEN=

# ───────── Autonomy policy ─────────
AUTONOMY_LEVEL=review             # observe | review | autopilot
AUTOPILOT_MIN_CONFIDENCE=0.92     # patches below this always need a human
AUTOPILOT_MAX_DIFF_LINES=60

# ───────── Observability ─────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
TYPHOID_SERVICE_TOKEN=          # JWT with role=service, minted at deploy time
TYPHOID_API=http://backend:8000
